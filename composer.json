{
    "name": "monstrex/ave-site",
    "description": "Site CMS extension for Ave Admin Panel",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "admin", "cms", "ave", "site"],
    "authors": [
        {
            "name": "MonstreX",
            "email": "fido6080net@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0",
        "monstrex/ave": "^2.0|dev-master",
        "liquid/liquid": "^1.4.44",
        "webwizo/laravel-shortcodes": "^1.0.27"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Monstrex\\AveSite\\": "src/",
            "Monstrex\\AveSite\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Monstrex\\AveSite\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Monstrex\\AveSite\\Providers\\AveSiteServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
